{
  "name": "exemplify",
  "version": "1.0.0",
  "description": "Score analysis desktop app",
  "author": "Duroje Gwamna",
  "build.appID": "com.dgwam.exemplify",
  "license": "MIT",

  "main": "main.js",

  "scripts": {
    "start": "electron .",

    "flask": "python flask_app.py",

    "build": "electron-builder"
  },

  "dependencies": {},

  "devDependencies": {
    "electron": "^29.0.0"
  },


  "build": {
    "appId": "com.yourname.exemplify",
    "productName": "eXeMpLify",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "html/**/*",
      "!html/node_modules"
    ],
    "extraResources": [
        {
            "from": "flask_app.py",
            "to": "flask_app.py"
        },
        {
            "from": "model.pkl",
            "to": "model.pkl"
        }

    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
